[Unit]
Description=Local Deepgram Voice Agent GUI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/adapt/projects/stt
Environment=PYTHONUNBUFFERED=1
Environment=VOICE_AGENT_HOST=127.0.0.1
Environment=VOICE_AGENT_PORT=18087
Environment=VOICE_AGENT_SECRET_FILE=/adapt/secrets/m2.env
Environment=VOICE_AGENT_DEEPGRAM_KEY_ENVS=DEEPGRAM_API_KEY,DEEPGRAM_API_KEY_nc
Environment=VOICE_AGENT_DEEPSEEK_KEY_ENVS=DEEPSEEK_API_KEY
Environment=VOICE_AGENT_LISTEN_MODEL=nova-2
Environment=VOICE_AGENT_THINK_URL=https://dg.adaptdev.ai/v1/chat/completions
Environment=VOICE_AGENT_THINK_MODEL=deepseek-v4-flash
Environment=VOICE_AGENT_PROXY_AUTH_KEY_ENVS=sage_20500_gateway_token
Environment=HOME=/adapt/novas/active/voice
Environment=VOICE_AGENT_HOME=/adapt/novas/active/voice
Environment=VOICE_AGENT_YOLO=1
Environment=VOICE_AGENT_ALLOW_SUDO=1
Environment=VOICE_AGENT_SANDBOX=none
Environment=VOICE_AGENT_APPROVAL_POLICY=never
Environment=VOICE_AGENT_TOOL_SCOPE=all
ExecStart=/usr/bin/python3 /adapt/projects/stt/deepgram_voice_agent_gui.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
